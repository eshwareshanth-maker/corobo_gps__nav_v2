<?xml version="1.0"?>
<sdf version="1.6">
  <world name="corobo_outdoor">

    <!-- THE DATUM: this is what turns Gazebo X/Y into real lat/lon -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>13.0100000</latitude_deg>
      <longitude_deg>80.2350000</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="box_a">
      <static>true</static>
      <pose>6 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1 1 1</size></box></geometry></visual>
      </link>
    </model>

    <model name="box_b">
      <static>true</static>
      <pose>12 -3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.5 1.5 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.5 1.5 1</size></box></geometry></visual>
      </link>
    </model>

    <model name="cyl_a">
      <static>true</static>
      <pose>9 4 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>1.2</length></cylinder></geometry></visual>
      </link>
    </model>

    <model name="wall">
      <static>true</static>
      <pose>18 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 10 1.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 10 1.5</size></box></geometry></visual>
      </link>
    </model>

  </world>
</sdf>
